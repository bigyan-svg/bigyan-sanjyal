{
  "name": "bigyan-sanjyal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "prisma generate --config prisma7.config.ts",
    "dev": "next dev",
    "build": "prisma generate --config prisma7.config.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import=tsx --test tests/*.test.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "admin:operator": "node --conditions=react-server --import=tsx scripts/admin-operator.ts",
    "admin:preview:bootstrap": "node --conditions=react-server --import=tsx scripts/admin-preview-bootstrap.ts",
    "db:migrate": "prisma migrate dev --config prisma.migrate.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.deploy.config.ts",
    "db:studio": "prisma studio",
    "db:integration:verify": "node --conditions=react-server --import=tsx scripts/verify-integration-test-target.ts",
    "db:integration:verify-empty": "node --conditions=react-server --import=tsx scripts/verify-integration-test-target.ts --require-empty",
    "db:integration:verify-schema": "node --conditions=react-server --import=tsx scripts/verify-integration-test-target.ts --verify-schema",
    "db:integration:verify-fixtures-clean": "node --conditions=react-server --import=tsx scripts/verify-integration-test-target.ts --verify-fixtures-clean",
    "db:integration:migrate": "npm run db:integration:verify && prisma --config prisma.integration.config.ts migrate deploy",
    "test:integration:concurrency": "npm run db:integration:verify-schema && node --conditions=react-server --import=tsx --test tests/postgres-concurrency.integration.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "argon2": "0.45.1",
    "dotenv": "18.0.9",
    "lucide-react": "^1.64.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "argon2": true
  },
  "engines": {
    "node": "^22.12.0"
  }
}
