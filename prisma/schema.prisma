generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProjectLinkType {
  GITHUB_REPOSITORY
  LIVE_DEMO
  DOCUMENTATION
  OTHER
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
  SPAM
}

enum AdminRole {
  ADMIN
  EDITOR
}

model SiteProfile {
  id          Int          @id @default(1) @db.SmallInt
  displayName String       @db.VarChar(120)
  headline    String?      @db.VarChar(160)
  shortBio    String?      @db.VarChar(300)
  biography   String?      @db.Text
  avatarUrl   String?      @db.Text
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  socialLinks SocialLink[]
}

model SocialLink {
  id        String      @id @default(uuid()) @db.Uuid
  profileId Int         @db.SmallInt
  label     String      @db.VarChar(60)
  url       String      @db.Text
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @default(now()) @updatedAt @db.Timestamptz(6)
  profile   SiteProfile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([profileId, sortOrder])
}

model SkillCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  skills      Skill[]

  @@index([sortOrder])
}

model Skill {
  id               String         @id @default(uuid()) @db.Uuid
  categoryId       String         @db.Uuid
  name             String         @db.VarChar(120)
  icon             String?        @db.VarChar(80)
  description      String?        @db.Text
  proficiencyLabel String?        @db.VarChar(40)
  status           ContentStatus  @default(DRAFT)
  publishedAt      DateTime?      @db.Timestamptz(6)
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  category         SkillCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projectSkills    ProjectSkill[]

  @@unique([categoryId, name])
  @@index([categoryId, status, sortOrder, publishedAt])
  @@index([status, sortOrder, publishedAt])
}

model ProjectCategory {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.Text
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  projects    Project[]

  @@index([sortOrder])
}

model Project {
  id          String           @id @default(uuid()) @db.Uuid
  categoryId  String?          @db.Uuid
  title       String           @db.VarChar(200)
  slug        String           @unique @db.VarChar(180)
  summary     String           @db.VarChar(400)
  description String?          @db.Text
  status      ContentStatus    @default(DRAFT)
  featured    Boolean          @default(false)
  publishedAt DateTime?        @db.Timestamptz(6)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  category    ProjectCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  links       ProjectLink[]
  images      ProjectImage[]
  skills      ProjectSkill[]

  @@index([categoryId, status, sortOrder, publishedAt])
  @@index([status, sortOrder, publishedAt])
}

model ProjectLink {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  type      ProjectLinkType @default(OTHER)
  label     String   @db.VarChar(80)
  url       String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId, sortOrder])
}

model ProjectImage {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  imageUrl  String   @db.Text
  altText   String   @db.VarChar(300)
  caption   String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([projectId, sortOrder])
}

model ProjectSkill {
  projectId String  @db.Uuid
  skillId   String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model PostCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  posts       Post[]

  @@index([sortOrder])
}

model Post {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String?       @db.Uuid
  title       String        @db.VarChar(200)
  slug        String        @unique @db.VarChar(180)
  excerpt     String?       @db.VarChar(500)
  body        String        @db.Text
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)
  category    PostCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  tags        PostTag[]

  @@index([categoryId, status, publishedAt])
  @@index([status, publishedAt])
}

model Tag {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(80)
  slug      String    @unique @db.VarChar(100)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  posts     PostTag[]
}

model PostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model Education {
  id           String        @id @default(uuid()) @db.Uuid
  institution  String        @db.VarChar(200)
  program      String        @db.VarChar(200)
  fieldOfStudy String?       @db.VarChar(200)
  description  String?       @db.Text
  startDate    DateTime?     @db.Date
  endDate      DateTime?     @db.Date
  isCurrent    Boolean       @default(false)
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?     @db.Timestamptz(6)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, publishedAt, sortOrder])
}

model WorkExperience {
  id          String        @id @default(uuid()) @db.Uuid
  employer    String        @db.VarChar(200)
  roleTitle   String        @db.VarChar(160)
  location    String?       @db.VarChar(160)
  description String?       @db.Text
  startDate   DateTime?     @db.Date
  endDate     DateTime?     @db.Date
  isCurrent   Boolean       @default(false)
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?     @db.Timestamptz(6)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, publishedAt, sortOrder])
}

model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  name      String               @db.VarChar(120)
  email     String               @db.VarChar(320)
  subject   String?              @db.VarChar(200)
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  readAt    DateTime?            @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([createdAt])
}

model AdminUser {
  id                String         @id @default(uuid()) @db.Uuid
  email             String         @unique @db.VarChar(320)
  passwordHash      String         @db.VarChar(255)
  passwordChangedAt DateTime       @default(now()) @db.Timestamptz(6)
  role              AdminRole      @default(ADMIN)
  isActive          Boolean        @default(true)
  lastLoginAt       DateTime?      @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  sessions          AdminSession[]
}

model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime  @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}
