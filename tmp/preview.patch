+import "server-only";
+import { S3Client } from "@aws-sdk/client-s3";
+export function getMediaStorageConfig() {
+  const endpoint = process.env.NEON_STORAGE_ENDPOINT;
+  const accessKeyId = process.env.NEON_STORAGE_ACCESS_KEY_ID;
+  const secretAccessKey = process.env.NEON_STORAGE_SECRET_ACCESS_KEY;
+  const bucket = process.env.NEON_STORAGE_BUCKET;
+  const region = process.env.NEON_STORAGE_REGION;
+  if (!endpoint || !accessKeyId || !secretAccessKey || !bucket || !region) throw new Error("Preview media storage is not configured.");
+  return { endpoint, accessKeyId, secretAccessKey, bucket, region };
+}
+let client: S3Client | undefined;
+export function getMediaS3Client() {
+  if (client) return client;
+  const c = getMediaStorageConfig();
+  client = new S3Client({ endpoint: c.endpoint, region: c.region, forcePathStyle: process.env.NEON_STORAGE_FORCE_PATH_STYLE === "true", credentials: { accessKeyId: c.accessKeyId, secretAccessKey: c.secretAccessKey } });
+  return client;
+}
