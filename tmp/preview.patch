+import { getUploadPolicy, safeOriginalName, type UploadDescriptor } from "@/lib/media/policy";
+import { getMediaS3Client, getMediaStorageConfig } from "@/lib/media/storage";
+
+export async function POST(request: Request) {
+  const denied = await authorizeAdminContentWrite(request);
+  if (denied) return denied;
+  let body: unknown;
+  try { body = await request.json(); } catch { return adminContentResponse({ error: "Invalid upload request." }, 400); }
