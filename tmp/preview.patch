+import { prisma } from "@/lib/prisma";
+import { deleteStoredObject } from "@/lib/media/processing";
+interface RouteContext { params: Promise<{ id: string }> }
+export async function PATCH(request: Request, context: RouteContext) {
+  const denied = await authorizeAdminContentWrite(request);
+  if (denied) return denied;
+  const { id } = await context.params;
+  let body: unknown;
+  try { body = await request.json(); } catch { return adminContentResponse({ error: "Invalid media metadata." }, 400); }
+  if (!body || typeof body !== "object") return adminContentResponse({ error: "Invalid media metadata." }, 400);
+  const input = body as Record<string, unknown>;
+  if (input.visibility === "PUBLIC") {
+  }
+  const data: { altText?: string | null; tags?: string[]; visibility?: "PRIVATE" | "PUBLIC" } = {};
+  if ("altText" in input) {
+    if (typeof input.altText !== "string" || input.altText.length > 300) return adminContentResponse({ error: "Alt text must be 300 characters or fewer." }, 422);
+    data.altText = input.altText.trim() || null;
+  }
+  if ("tags" in input) {
+    if (!Array.isArray(input.tags) || input.tags.length > 30 || input.tags.some((tag) => typeof tag !== "string" || tag.length > 50)) return adminContentResponse({ error: "Tags must be a list of up to 30 short labels." }, 422);
+    data.tags = [...new Set(input.tags.map((tag) => (tag as string).trim()).filter(Boolean))];
+  }
+  if ("visibility" in input) {
+    if (input.visibility !== "PRIVATE" && input.visibility !== "PUBLIC") return adminContentResponse({ error: "Invalid visibility setting." }, 422);
+    data.visibility = input.visibility;
+  }
+  if (!Object.keys(data).length) return adminContentResponse({ error: "No valid media fields were provided." }, 422);
+  const asset = await prisma.portfolioMediaAsset.updateMany({ where: { id, status: "READY" }, data });
+  if (!asset.count) return adminContentResponse({ error: "Media asset not found." }, 404);
+  return adminContentResponse({ saved: true }, 200);
+}
+export async function DELETE(request: Request, context: RouteContext) {
+  const denied = await authorizeAdminContentWrite(request);
+  if (denied) return denied;
+  const { id } = await context.params;
+  const asset = await prisma.portfolioMediaAsset.findUnique({ where: { id }, include: { _count: { select: { references: true } } } });
+  if (!asset) return adminContentResponse({ error: "Media asset not found." }, 404);
+  if (asset._count.references > 0) return adminContentResponse({ error: "This asset is attached to published or saved content. Remove its references before deleting it.", referenceCount: asset._count.references }, 409);
+  const variants = Array.isArray(asset.variants) ? asset.variants as { key?: string }[] : [];
+  try {
+    await Promise.all([asset.storageKey, ...variants.map((variant) => variant.key).filter((key): key is string => Boolean(key))].map(deleteStoredObject));
+    await prisma.portfolioMediaAsset.delete({ where: { id } });
+    return adminContentResponse({ deleted: true }, 200);
+  } catch {
+    return adminContentResponse({ error: "Storage deletion failed. The asset record was retained." }, 503);
+  }
