@@ -0,0 +1,62 @@
+import "server-only";
+import { DeleteObjectCommand, GetObjectCommand, PutObjectCommand } from "@aws-sdk/client-s3";
+import { DOMParser, XMLSerializer, type Element as XmlElement } from "@xmldom/xmldom";
+import sharp from "sharp";
+import { getMediaS3Client, getMediaStorageConfig } from "./storage";
+
+export async function readStoredObject(key: string, range?: string): Promise<Buffer> {
+  const c = getMediaStorageConfig();
+  const result = await getMediaS3Client().send(new GetObjectCommand({ Bucket: c.bucket, Key: key, Range: range }));
+  if (!result.Body) throw new Error("Uploaded object is empty.");
+  return Buffer.from(await result.Body.transformToByteArray());
+}
+export async function putStoredObject(key: string, body: Buffer, contentType: string) {
+  const c = getMediaStorageConfig();
+  await getMediaS3Client().send(new PutObjectCommand({ Bucket: c.bucket, Key: key, Body: body, ContentType: contentType, ContentLength: body.byteLength }));
+}
+export async function deleteStoredObject(key: string) {
+  const c = getMediaStorageConfig();
+  await getMediaS3Client().send(new DeleteObjectCommand({ Bucket: c.bucket, Key: key }));
+}
+export function sanitizeSvg(input: Buffer): Buffer {
+  const source = input.toString("utf8");
+  if (/<!DOCTYPE|<!ENTITY/iu.test(source)) throw new Error("SVG document declarations are not permitted.");
+  let parseError = false;
+  const document = new DOMParser({ errorHandler: () => { parseError = true; } }).parseFromString(source, "image/svg+xml");
+  const root = document.documentElement;
+  if (parseError || root?.localName?.toLowerCase() !== "svg") throw new Error("The SVG file is malformed.");
+  const blocked = new Set(["script", "foreignobject", "iframe", "object", "embed", "audio", "video"]);
+  const clean = (node: XmlElement) => {
+    for (let i = node.attributes.length - 1; i >= 0; i--) {
+      const attr = node.attributes.item(i);
+      if (!attr) continue;
+      const name = attr.name.toLowerCase();
+      const value = attr.value.trim();
+      if (name.startsWith("on") || name === "style" || name === "src" || ((name === "href" || name.endsWith(":href")) && !value.startsWith("#"))) node.removeAttribute(attr.name);
+    }
+    for (let i = node.childNodes.length - 1; i >= 0; i--) {
+      const child = node.childNodes.item(i);
+      if (!child) continue;
+      if (child.nodeType === 1) {
+        const element = child as unknown as XmlElement;
+        if (blocked.has(element.localName?.toLowerCase() ?? "")) node.removeChild(child);
+        else clean(element);
+      }
+    }
+  };
+  clean(root);
+  return Buffer.from(new XMLSerializer().serializeToString(document), "utf8");
+}
+export async function makeImageVariants(originalKey: string, bytes: Buffer) {
+  const metadata = await sharp(bytes, { limitInputPixels: 60_000_000 }).metadata();
+  if (!metadata.width || !metadata.height || metadata.width * metadata.height > 60_000_000) throw new Error("Image dimensions exceed the processing limit.");
+  const variants: { width: number; key: string; mimeType: string }[] = [];
+  for (const width of [400, 800, 1600]) {
+    if (metadata.width < width && variants.length > 0) continue;
+    const key = originalKey.replace(/\.[^.]+$/, `-${width}.webp`);
+    const body = await sharp(bytes, { limitInputPixels: 60_000_000 }).rotate().resize({ width, withoutEnlargement: true }).webp({ quality: 82 }).toBuffer();
+    await putStoredObject(key, body, "image/webp");
+    variants.push({ width: Math.min(width, metadata.width), key, mimeType: "image/webp" });
+  }
+  return { width: metadata.width, height: metadata.height, variants };
+}
