+  }
+  return (
+    <div className="media-library">
+      <Card variant="outlined" className="media-library__upload">
+        <div className="media-library__section-head"><div><p className="eyebrow">Private asset vault</p><h2>Upload from your computer</h2><p>Files are uploaded directly to private storage and remain private until you publish them.</p></div><Upload aria-hidden="true" size={24} /></div>
+        <label className="media-library__dropzone" onDragOver={(event: DragEvent<HTMLLabelElement>) => event.preventDefault()} onDrop={(event: DragEvent<HTMLLabelElement>) => { event.preventDefault(); void uploadFiles(event.dataTransfer.files); }}><ImagePlus aria-hidden="true" size={28} /><strong>Select files from your computer</strong><span>Images/SVG 10 MB · Videos 150 MB · Documents/Office/ZIP 50 MB</span><input type="file" multiple disabled={busy} accept=".webp,.png,.jpg,.jpeg,.svg,.ico,.mp4,.webm,.gif,.pdf,.docx,.pptx,.xlsx,.csv,.zip" onChange={(event) => void uploadFiles(event.currentTarget.files ?? [])} /></label>
+        {progress.length ? <div className="media-library__progress" aria-live="polite">{progress.map((item, index) => <div className="media-library__progress-row" key={`${item.name}-${index}`}><div><strong>{item.name}</strong><span>{item.status}</span></div><progress max={100} value={item.percent} /></div>)}</div> : null}
+      </Card>
+      <Card variant="outlined" className="media-library__inventory">
+        <div className="media-library__section-head"><div><p className="eyebrow">Asset management</p><h2>Media library <span className="media-library__count">{assets.length}</span></h2></div></div>
+        <div className="media-library__filters"><label className="media-library__search"><Search aria-hidden="true" size={17} /><input value={query} onChange={(event) => { setQuery(event.target.value); setPage(1); }} placeholder="Search filenames or alt text" aria-label="Search media" /></label><select value={category} onChange={(event) => { setCategory(event.target.value); setPage(1); }} aria-label="Filter media type"><option value="all">All file types</option><option value="image">Images & SVG</option><option value="video">Videos & GIFs</option><option value="document">PDF documents</option><option value="office">Office & data</option><option value="archive">ZIP archives</option></select><Button variant="secondary" onClick={() => void loadAssets()} disabled={busy}>Refresh</Button></div>
+        <div className="media-library__pagination"><span>Showing {total ? (page - 1) * 40 + 1 : 0}–{Math.min(page * 40, total)} of {total}</span><div><Button size="small" variant="secondary" disabled={page <= 1 || busy} onClick={() => setPage((value) => Math.max(1, value - 1))}>Previous</Button><Button size="small" variant="secondary" disabled={page * 40 >= total || busy} onClick={() => setPage((value) => value + 1)}>Next</Button></div></div>
+        {error ? <p className="media-library__notice media-library__notice--error" role="alert">{error}</p> : null}
+        {success ? <p className="media-library__notice" role="status">{success}</p> : null}
+        {assets.length ? <div className="media-library__grid">{assets.map((asset) => <MediaAssetCard key={asset.id} asset={asset} onSave={updateAsset} onDelete={deleteAsset} />)}</div> : <div className="media-library__empty"><ImagePlus aria-hidden="true" size={32} /><p>No matching assets yet. Upload a file to start your library.</p></div>}
+      </Card>
+    </div>
+  );
+}
+function MediaAssetCard({ asset, onSave, onDelete }: { asset: Asset; onSave: (id: string, changes: Record<string, unknown>) => Promise<void>; onDelete: (asset: Asset) => Promise<void> }) {
+  const [altText, setAltText] = useState(asset.altText ?? "");
+  const [tags, setTags] = useState(Array.isArray(asset.tags) ? (asset.tags as string[]).join(", ") : "");
+  const isImage = asset.mimeType.startsWith("image/");
+  return (
+    <article className="media-library__asset">
+      <div className="media-library__preview">{isImage ? <Image src={asset.url} alt={altText} fill unoptimized sizes="(max-width: 640px) 100vw, (max-width: 1200px) 50vw, 320px" /> : asset.category === "video" ? <video src={asset.url} controls preload="metadata" aria-label={asset.originalName} /> : asset.mimeType === "application/pdf" ? <iframe src={asset.url} title={`PDF preview: ${asset.originalName}`} /> : <FileText aria-hidden="true" size={32} />}<span>{asset.mimeType.split("/").pop()}</span></div>
+      <div className="media-library__asset-body"><strong title={asset.originalName}>{asset.originalName}</strong><small>{formatBytes(asset.sizeBytes)}{asset.width && asset.height ? ` · ${asset.width}×${asset.height}` : ""}</small><small>{asset.referenceCount ? `${asset.referenceCount} linked reference(s)` : "Not linked to content"}</small><a className="media-library__download" href={asset.url} target="_blank" rel="noreferrer">Open / download original</a>
+        <label>Alt text<input value={altText} maxLength={300} onChange={(event) => setAltText(event.target.value)} /></label><label>Tags<input value={tags} onChange={(event) => setTags(event.target.value)} placeholder="comma-separated tags" /></label>
+        <div className="media-library__asset-actions"><Button variant="secondary" size="small" onClick={() => void onSave(asset.id, { altText, tags: tags.split(",").map((tag) => tag.trim()).filter(Boolean) })}><Check size={15} /> Save</Button><Button variant="secondary" size="small" onClick={() => void onSave(asset.id, { visibility: asset.visibility === "PUBLIC" ? "PRIVATE" : "PUBLIC" })}>{asset.visibility === "PUBLIC" ? <><EyeOff size={15} /> Make private</> : <><Eye size={15} /> Publish asset</>}</Button><Button variant="secondary" size="small" disabled={asset.referenceCount > 0} onClick={() => void onDelete(asset)}><Trash2 size={15} /> Delete</Button></div>
+      </div>
+    </article>
+  );
+}
