+import "server-only";
+import type { Prisma } from "@/generated/prisma/client";
+export class MediaAssetUnavailableError extends Error {}
+export class MediaAssetMustBePublicError extends Error {}
+export function mediaAssetIdFromUrl(value: string): string | null {
+  const match = /^\/api\/media\/([0-9a-f-]{36})$/iu.exec(value.trim());
+  return match?.[1] ?? null;
+}
+export async function syncMediaReferences(transaction: Prisma.TransactionClient, resourceType: string, resourceId: string, field: string, urls: readonly string[], mustBePublic: boolean) {
+  const references = transaction.portfolioMediaAssetReference;
+  if (!references) return;
+  const ids = [...new Set(urls.map(mediaAssetIdFromUrl).filter((id): id is string => Boolean(id)))];
+  const assets = ids.length ? await transaction.portfolioMediaAsset.findMany({ where: { id: { in: ids } }, select: { id: true, status: true, visibility: true } }) : [];
+  if (assets.length !== ids.length || assets.some((asset) => asset.status !== "READY")) throw new MediaAssetUnavailableError("An attached media asset is missing or has not passed validation.");
+  if (mustBePublic && assets.some((asset) => asset.visibility !== "PUBLIC")) throw new MediaAssetMustBePublicError("Publish attached media assets before publishing this content.");
+  await references.deleteMany({ where: { resourceType, resourceId, field } });
+  if (ids.length) await references.createMany({ data: ids.map((mediaAssetId) => ({ mediaAssetId, resourceType, resourceId, field })), skipDuplicates: true });
+}
