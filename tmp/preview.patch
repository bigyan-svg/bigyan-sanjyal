+import "server-only";
+import { adminContentResponse, authorizeAdminContentWrite } from "@/lib/auth/admin-content";
+import { prisma } from "@/lib/prisma";
+interface Context { params: Promise<{ id: string }> }
+export async function PATCH(request: Request, context: Context) {
+  const denied = await authorizeAdminContentWrite(request); if (denied) return denied;
+  const { id } = await context.params;
+  let body: unknown; try { body = await request.json(); } catch { return adminContentResponse({ error: "Invalid CV update." }, 400); }
+  if (!body || typeof body !== "object") return adminContentResponse({ error: "Invalid CV update." }, 400);
+  const input = body as Record<string, unknown>;
+  const existing = await prisma.cvVersion.findUnique({ where: { id } }); if (!existing) return adminContentResponse({ error: "CV version not found." }, 404);
+  const data: { versionLabel?: string; trackName?: "INDUSTRY" | "ACADEMIC"; isActive?: boolean } = {};
+  if ("versionLabel" in input) { if (typeof input.versionLabel !== "string" || !input.versionLabel.trim() || input.versionLabel.length > 120) return adminContentResponse({ error: "Version label must be 1–120 characters." }, 422); data.versionLabel = input.versionLabel.trim(); }
+  if ("trackName" in input) { if (input.trackName !== "INDUSTRY" && input.trackName !== "ACADEMIC") return adminContentResponse({ error: "Invalid CV track." }, 422); data.trackName = input.trackName; }
+  if ("isActive" in input) { if (typeof input.isActive !== "boolean") return adminContentResponse({ error: "Active status must be true or false." }, 422); data.isActive = input.isActive; }
+  if (!Object.keys(data).length) return adminContentResponse({ error: "No changes provided." }, 422);
+  const version = await prisma.$transaction(async (tx) => {
+    const targetTrack = data.trackName ?? existing.trackName;
+    if (data.isActive === true) await tx.cvVersion.updateMany({ where: { trackName: targetTrack, isActive: true, NOT: { id } }, data: { isActive: false } });
+    return tx.cvVersion.update({ where: { id }, data });
+  });
+  return adminContentResponse({ version }, 200);
+}
+export async function DELETE(request: Request, context: Context) {
+  const denied = await authorizeAdminContentWrite(request); if (denied) return denied;
+  const { id } = await context.params;
+  const version = await prisma.cvVersion.findUnique({ where: { id } }); if (!version) return adminContentResponse({ error: "CV version not found." }, 404);
+  if (version.isActive) return adminContentResponse({ error: "Deactivate this CV version before deleting it." }, 409);
+  await prisma.$transaction(async (tx) => {
+    await tx.portfolioMediaAssetReference.deleteMany({ where: { resourceType: "cv", resourceId: id } });
+    await tx.cvVersion.delete({ where: { id } });
+  });
+  return adminContentResponse({ deleted: true }, 200);
+}
