+import "server-only";
+import { adminContentResponse, authorizeAdminContentRead } from "@/lib/auth/admin-content";
+import { prisma } from "@/lib/prisma";
+import { MediaAssetVisibility, Prisma } from "@/generated/prisma/client";
+export async function GET(request: Request) {
+  const denied = await authorizeAdminContentRead(request);
+  if (denied) return denied;
+  const url = new URL(request.url);
+  const query = url.searchParams.get("q")?.trim().slice(0, 120) ?? "";
+  const category = url.searchParams.get("category") ?? "";
+  const visibility = url.searchParams.get("visibility") ?? "";
+  const page = Math.max(1, Number.parseInt(url.searchParams.get("page") ?? "1", 10) || 1);
+  const visibilityFilter: MediaAssetVisibility | undefined = visibility === "PUBLIC" || visibility === "PRIVATE" ? visibility : undefined;
+  const where: Prisma.PortfolioMediaAssetWhereInput = {
+    status: "READY" as const,
+    ...(category && ["image", "video", "document", "office", "archive"].includes(category) ? { category } : {}),
+    ...(visibilityFilter ? { visibility: visibilityFilter } : {}),
+    ...(query ? { OR: [{ originalName: { contains: query, mode: "insensitive" as const } }, { altText: { contains: query, mode: "insensitive" as const } }] } : {}),
+  };
+  const [assets, total] = await Promise.all([
+    prisma.portfolioMediaAsset.findMany({ where, orderBy: { createdAt: "desc" }, skip: (page - 1) * 40, take: 40, include: { _count: { select: { references: true } } } }),
+    prisma.portfolioMediaAsset.count({ where }),
+  ]);
+  return adminContentResponse({ assets: assets.map(({ sizeBytes, variants, _count, ...asset }) => ({ ...asset, sizeBytes: sizeBytes.toString(), variants, referenceCount: _count.references, url: `/api/media/${asset.id}` })), total, page, pageSize: 40 }, 200);
+}
