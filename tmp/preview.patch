+import assert from "node:assert/strict";
+import test from "node:test";
+import { getUploadPolicy, safeOriginalName, verifyMagicBytes } from "../src/lib/media/policy";
+test("media upload policy enforces allowed MIME and format-specific ceilings", () => {
+  assert.equal(getUploadPolicy({ name: "hero.webp", type: "image/webp", size: 10 * 1024 * 1024 })?.category, "image");
+  assert.equal(getUploadPolicy({ name: "demo.mp4", type: "video/mp4", size: 150 * 1024 * 1024 })?.category, "video");
+  assert.equal(getUploadPolicy({ name: "bad.exe", type: "application/octet-stream", size: 100 }) , null);
+  assert.equal(getUploadPolicy({ name: "photo.png", type: "image/jpeg", size: 100 }) , null);
+  assert.equal(getUploadPolicy({ name: "large.png", type: "image/png", size: 10 * 1024 * 1024 + 1 }) , null);
+});
+test("media policy verifies binary signatures instead of trusting extensions", () => {
+  assert.equal(verifyMagicBytes("png", Uint8Array.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a])), true);
+  assert.equal(verifyMagicBytes("png", Uint8Array.from([0x4d, 0x5a, 0x00, 0x00])), false);
+  assert.equal(verifyMagicBytes("pdf", new TextEncoder().encode("%PDF-1.7")), true);
+  assert.equal(verifyMagicBytes("mp4", new TextEncoder().encode("0000ftypisom")), true);
+});
+test("uploaded filenames are normalized and cannot contain path separators or controls", () => {
+  assert.equal(safeOriginalName("../my\\report\n.pdf"), ".._my_report _.pdf".replace(" ", ""));
+  assert.equal(safeOriginalName("  résumé.pdf  "), "résumé.pdf");
+});
