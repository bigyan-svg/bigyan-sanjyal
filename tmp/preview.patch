new file mode 100644
index 0000000..52d05cb
--- /dev/null
+++ b/src/lib/media/policy.ts
@@ -0,0 +1,71 @@
+export type MediaCategory = "image" | "video" | "document" | "office" | "archive";
+export interface UploadDescriptor { name: string; type: string; size: number }
+export const MIME_BY_EXTENSION: Record<string, string> = {
+  webp: "image/webp", png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", svg: "image/svg+xml", ico: "image/x-icon",
+  mp4: "video/mp4", webm: "video/webm", gif: "image/gif", pdf: "application/pdf",
+  docx: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
+  pptx: "application/vnd.openxmlformats-officedocument.presentationml.presentation",
+  xlsx: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", csv: "text/csv", zip: "application/zip",
+};
+export function getUploadPolicy(file: UploadDescriptor) {
+  const extension = file.name.split(".").pop()?.toLowerCase() ?? "";
+  const mimeType = MIME_BY_EXTENSION[extension];
+  if (!mimeType || file.type.toLowerCase() !== mimeType) return null;
+  const category: MediaCategory = ["mp4", "webm"].includes(extension) ? "video" : extension === "pdf" ? "document" : ["docx", "pptx", "xlsx", "csv"].includes(extension) ? "office" : extension === "zip" ? "archive" : "image";
+  const maxBytes = category === "image" ? 10 * 1024 * 1024 : category === "video" ? 150 * 1024 * 1024 : 50 * 1024 * 1024;
+  if (!Number.isSafeInteger(file.size) || file.size < 1 || file.size > maxBytes) return null;
+  return { extension, mimeType, category, maxBytes };
+}
+export function safeOriginalName(name: string) {
+  return name.normalize("NFKC").replace(/[\\/\0-\x1f\x7f]/g, "_").replace(/\s+/g, " ").trim().slice(0, 255) || "upload";
+}
+export function verifyMagicBytes(extension: string, bytes: Uint8Array): boolean {
+  const starts = (...values: number[]) => values.every((value, index) => bytes[index] === value);
+  const text = (from: number, to: number) => String.fromCharCode(...bytes.slice(from, to));
+  switch (extension) {
+    case "jpg": case "jpeg": return starts(0xff, 0xd8, 0xff);
+    case "png": return starts(0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a);
+    case "webp": return starts(0x52, 0x49, 0x46, 0x46) && text(8, 12) === "WEBP";
+    case "gif": return ["GIF87a", "GIF89a"].includes(text(0, 6));
+    case "ico": return starts(0, 0, 1, 0);
+    case "mp4": return bytes.length >= 12 && text(4, 8) === "ftyp";
+    case "webm": return starts(0x1a, 0x45, 0xdf, 0xa3);
+    case "pdf": return text(0, 5) === "%PDF-";
+    case "docx": case "pptx": case "xlsx": case "zip": return starts(0x50, 0x4b, 0x03, 0x04) || starts(0x50, 0x4b, 0x05, 0x06) || starts(0x50, 0x4b, 0x07, 0x08);
+    case "csv": return bytes.length > 0 && !bytes.slice(0, 4096).includes(0);
+    case "svg": { const sample = new TextDecoder().decode(bytes.slice(0, 2048)); return sample.trimStart().startsWith("<") && /<svg[\s>]/i.test(sample); }
+    default: return false;
+  }
+}
+
+export function verifyZipPackage(extension: string, bytes: Uint8Array): boolean {
+  const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+  const start = Math.max(0, bytes.length - 65_557);
+  let end = -1;
+  for (let i = bytes.length - 22; i >= start; i--) {
+    if (view.getUint32(i, true) === 0x06054b50) { end = i; break; }
+  }
+  if (end < 0) return false;
+  const entries = view.getUint16(end + 10, true);
+  const directorySize = view.getUint32(end + 12, true);
+  let offset = view.getUint32(end + 16, true);
+  if (entries > 10_000 || offset + directorySize > bytes.length) return false;
+  const names = new Set<string>(); let expanded = 0;
+  for (let i = 0; i < entries; i++) {
+    if (offset + 46 > bytes.length || view.getUint32(offset, true) !== 0x02014b50) return false;
+    const flags = view.getUint16(offset + 8, true);
+    const uncompressed = view.getUint32(offset + 24, true);
+    const nameLength = view.getUint16(offset + 28, true);
+    const extraLength = view.getUint16(offset + 30, true);
+    const commentLength = view.getUint16(offset + 32, true);
+    if (flags & 1 || offset + 46 + nameLength + extraLength + commentLength > bytes.length) return false;
+    const name = new TextDecoder().decode(bytes.slice(offset + 46, offset + 46 + nameLength)).replace(/\\/g, "/");
+    if (name.startsWith("/") || name.split("/").some((part) => part === "..")) return false;
+    expanded += uncompressed; if (expanded > 500 * 1024 * 1024) return false;
+    names.add(name); offset += 46 + nameLength + extraLength + commentLength;
+  }
+  if (extension === "docx") return names.has("[Content_Types].xml") && names.has("word/document.xml");
+  if (extension === "pptx") return names.has("[Content_Types].xml") && names.has("ppt/presentation.xml");
+  if (extension === "xlsx") return names.has("[Content_Types].xml") && names.has("xl/workbook.xml");
+  return extension === "zip";
+}
