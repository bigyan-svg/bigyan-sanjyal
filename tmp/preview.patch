new file mode 100644
index 0000000..805db8b
--- /dev/null
+++ b/src/app/api/media/[id]/route.ts
@@ -0,0 +1,41 @@
+import "server-only";
+import { GetObjectCommand } from "@aws-sdk/client-s3";
+import { authorizeAdminContentRead } from "@/lib/auth/admin-content";
+import { prisma } from "@/lib/prisma";
+import { getMediaS3Client, getMediaStorageConfig } from "@/lib/media/storage";
+interface RouteContext { params: Promise<{ id: string }> }
+export async function GET(request: Request, context: RouteContext) {
+  const { id } = await context.params;
+  const asset = await prisma.portfolioMediaAsset.findUnique({ where: { id }, select: { storageKey: true, mimeType: true, originalName: true, status: true, visibility: true } });
+  if (!asset || asset.status !== "READY") return new Response("Not found", { status: 404 });
+  const isPublic = asset.visibility === "PUBLIC";
+  if (!isPublic) {
+    const denied = await authorizeAdminContentRead(request);
+    if (denied) return denied;
+  }
+  try {
+    const config = getMediaStorageConfig();
+    const range = request.headers.get("range") ?? undefined;
+    const result = await getMediaS3Client().send(new GetObjectCommand({ Bucket: config.bucket, Key: asset.storageKey, Range: range }));
+    if (!result.Body) return new Response("Media unavailable", { status: 502 });
+    const inline = asset.mimeType.startsWith("image/") || asset.mimeType.startsWith("video/") || asset.mimeType === "application/pdf";
+    const download = new URL(request.url).searchParams.get("download") === "1";
+    const filename = download && asset.mimeType === "application/pdf" ? "Bigyan_Sanjyal_CV.pdf" : download && asset.mimeType.includes("wordprocessingml.document") ? "Bigyan_Sanjyal_CV.docx" : asset.originalName;
+    const disposition = (download ? "attachment" : inline ? "inline" : "attachment") + "; filename*=UTF-8''" + encodeURIComponent(filename);
+    const headers = new Headers({
+      "Content-Type": asset.mimeType,
+      "Content-Disposition": disposition,
+      "X-Content-Type-Options": "nosniff",
+      "Content-Security-Policy": "default-src 'none'; sandbox",
+      "Cross-Origin-Resource-Policy": "same-site",
+      "Accept-Ranges": "bytes",
+      "Cache-Control": isPublic ? "public, max-age=3600, stale-while-revalidate=86400" : "private, no-store",
+    });
+    if (result.ContentLength !== undefined) headers.set("Content-Length", String(result.ContentLength));
+    if (result.ContentRange) headers.set("Content-Range", result.ContentRange);
+    if (result.ETag) headers.set("ETag", result.ETag);
+    return new Response(result.Body.transformToWebStream(), { status: result.ContentRange ? 206 : 200, headers });
+  } catch {
+    return new Response("Media unavailable", { status: 502, headers: { "Cache-Control": "no-store" } });
+  }
+}
diff --git a/src/app/api/public/cv/download/route.ts b/src/app/api/public/cv/download/route.ts
new file mode 100644
