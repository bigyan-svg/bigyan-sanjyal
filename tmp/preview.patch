+import { Check, Eye, EyeOff, FileText, ImagePlus, Search, Trash2, Upload } from "lucide-react";
+import { Button } from "@/components/ui/button";
+import { Card } from "@/components/ui/card";
+interface Asset { id: string; originalName: string; mimeType: string; category: string; sizeBytes: string; width: number | null; height: number | null; altText: string | null; tags: unknown; visibility: "PRIVATE" | "PUBLIC"; referenceCount: number; url: string }
+interface UploadProgress { name: string; percent: number; status: string }
+async function jsonRequest(url: string, method = "GET", body?: unknown) {
+  const response = await fetch(url, { method, credentials: "same-origin", cache: "no-store", headers: body ? { "Content-Type": "application/json" } : undefined, body: body ? JSON.stringify(body) : undefined });
+  const result = await response.json().catch(() => null);
+  if (!response.ok) throw new Error(result && typeof result.error === "string" ? result.error : "The request failed.");
+  return result;
+}
+function uploadWithProgress(url: string, file: File, headers: Record<string, string>, onProgress: (value: number) => void) {
+  return new Promise<void>((resolve, reject) => {
+    const xhr = new XMLHttpRequest();
+    xhr.open("PUT", url);
+    Object.entries(headers).forEach(([key, value]) => xhr.setRequestHeader(key, value));
+    xhr.upload.onprogress = (event) => { if (event.lengthComputable) onProgress(Math.round(event.loaded / event.total * 100)); };
+    xhr.onerror = () => reject(new Error("Upload connection failed. Please retry."));
+    xhr.onload = () => xhr.status >= 200 && xhr.status < 300 ? resolve() : reject(new Error(`Storage rejected the upload (${xhr.status}).`));
+    xhr.send(file);
+  });
+}
+function formatBytes(value: string) {
+  const bytes = Number(value);
+  if (!Number.isFinite(bytes)) return value;
+  const units = ["B", "KB", "MB", "GB"];
+  let size = bytes, index = 0;
+  while (size >= 1024 && index < units.length - 1) { size /= 1024; index++; }
+  return `${size.toFixed(index ? 1 : 0)} ${units[index]}`;
+}
+export function MediaManager() {
+  const [assets, setAssets] = useState<Asset[]>([]);
+  const [total, setTotal] = useState(0);
+  const [page, setPage] = useState(1);
+  const [query, setQuery] = useState("");
+  const [category, setCategory] = useState("all");
+  const [progress, setProgress] = useState<UploadProgress[]>([]);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const [success, setSuccess] = useState("");
+  const loadAssets = useCallback(async () => {
+    const params = new URLSearchParams({ q: query, page: String(page) });
+    if (category !== "all") params.set("category", category);
+    const result = await jsonRequest(`/api/admin/media?${params}`);
+    setAssets(result.assets as Asset[]); setTotal(result.total as number);
+  }, [query, category, page]);
+  useEffect(() => {
+    let active = true;
+    const params = new URLSearchParams({ q: query, page: String(page) });
+    if (category !== "all") params.set("category", category);
+    void jsonRequest(`/api/admin/media?${params}`).then((result) => { if (active) { setAssets(result.assets as Asset[]); setTotal(result.total as number); } }).catch((e: unknown) => { if (active) setError(e instanceof Error ? e.message : "Unable to load media."); });
+    return () => { active = false; };
+  }, [query, category, page]);
+  async function uploadFiles(selected: FileList | File[]) {
+    const files = Array.from(selected);
+    if (!files.length) return;
+    setBusy(true); setError(""); setSuccess("");
+    for (const file of files) {
+      setProgress((current) => [...current, { name: file.name, percent: 0, status: "Preparing secure upload…" }]);
+      try {
+        const ticket = await jsonRequest("/api/admin/media/upload-url", "POST", { name: file.name, type: file.type, size: file.size });
+        setProgress((current) => current.map((item) => item.name === file.name ? { ...item, status: "Uploading to private storage…" } : item));
+        await uploadWithProgress(ticket.uploadUrl, file, ticket.headers, (percent) => setProgress((current) => current.map((item) => item.name === file.name ? { ...item, percent } : item)));
+        setProgress((current) => current.map((item) => item.name === file.name ? { ...item, status: "Verifying file and generating previews…" } : item));
+        await jsonRequest("/api/admin/media/finalize", "POST", { assetId: ticket.assetId, altText: file.name.replace(/\.[^.]+$/, "") });
+        setProgress((current) => current.map((item) => item.name === file.name ? { ...item, percent: 100, status: "Complete" } : item));
+      } catch (e) {
+        setError(e instanceof Error ? e.message : `Unable to upload ${file.name}.`);
+        setProgress((current) => current.map((item) => item.name === file.name ? { ...item, status: "Failed" } : item));
+      }
+    }
+    setBusy(false);
+    await loadAssets().catch((e: unknown) => setError(e instanceof Error ? e.message : "Media list refresh failed."));
+    setSuccess("Upload processing finished. Review each file's status.");
+  }
+  async function updateAsset(id: string, changes: Record<string, unknown>) {
+    setError(""); setSuccess("");
+    try { await jsonRequest(`/api/admin/media/${id}`, "PATCH", changes); await loadAssets(); setSuccess("Media metadata saved."); }
+    catch (e) { setError(e instanceof Error ? e.message : "Unable to save media metadata."); }
+  }
+  async function deleteAsset(asset: Asset) {
+    if (!window.confirm(`Delete “${asset.originalName}”? This cannot be undone.`)) return;
+    try { await jsonRequest(`/api/admin/media/${asset.id}`, "DELETE"); setAssets((current) => current.filter((item) => item.id !== asset.id)); setSuccess("Asset deleted."); }
