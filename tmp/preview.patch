--- /dev/null
+++ b/src/app/api/public/cv/download/route.ts
@@ -0,0 +1,13 @@
+import "server-only";
+import { prisma } from "@/lib/prisma";
+export async function GET(request: Request) {
+  const url = new URL(request.url);
+  const track = url.searchParams.get("track") === "ACADEMIC" ? "ACADEMIC" : "INDUSTRY";
+  const format = url.searchParams.get("format") === "docx" ? "docx" : "pdf";
+  const version = await prisma.cvVersion.findFirst({ where: { trackName: track, isActive: true }, include: { pdfAsset: { select: { id: true, status: true, visibility: true } }, docxAsset: { select: { id: true, status: true, visibility: true } } } });
+  if (!version) return new Response("No active CV is configured for this track.", { status: 404, headers: { "Cache-Control": "no-store" } });
+  const asset = format === "docx" ? version.docxAsset : version.pdfAsset;
+  if (!asset || asset.status !== "READY" || asset.visibility !== "PUBLIC") return new Response("The requested CV file is unavailable.", { status: 404, headers: { "Cache-Control": "no-store" } });
+  await prisma.cvVersion.update({ where: { id: version.id }, data: { downloadCount: { increment: 1 } } });
+  return Response.redirect(new URL("/api/media/" + asset.id + "?download=1", request.url), 302);
+}
