+export async function POST(request: Request) {
+  const denied = await authorizeAdminContentWrite(request); if (denied) return denied;
+  let body: unknown; try { body = await request.json(); } catch { return adminContentResponse({ error: "Invalid CV version data." }, 400); }
+  if (!body || typeof body !== "object") return adminContentResponse({ error: "Invalid CV version data." }, 400);
+  const input = body as Record<string, unknown>;
+  const label = typeof input.versionLabel === "string" ? input.versionLabel.trim().slice(0, 120) : "";
+  const track = input.trackName === "ACADEMIC" ? "ACADEMIC" : input.trackName === "INDUSTRY" ? "INDUSTRY" : null;
+  const pdfId = typeof input.pdfAssetId === "string" ? input.pdfAssetId : "";
+  const docxId = typeof input.docxAssetId === "string" ? input.docxAssetId : null;
+  const active = input.isActive === true;
+  if (!label || !track || !/^[0-9a-f-]{36}$/iu.test(pdfId) || (docxId && !/^[0-9a-f-]{36}$/iu.test(docxId))) return adminContentResponse({ error: "Enter a version label, track, and valid uploaded PDF." }, 422);
+  const [pdf, docx] = await Promise.all([prisma.portfolioMediaAsset.findUnique({ where: { id: pdfId } }), docxId ? prisma.portfolioMediaAsset.findUnique({ where: { id: docxId } }) : Promise.resolve(null)]);
+  if (!pdf || pdf.status !== "READY" || pdf.visibility !== "PUBLIC" || pdf.mimeType !== "application/pdf") return adminContentResponse({ error: "The primary CV must be a verified, public PDF asset." }, 422);
+  if (docxId && (!docx || docx.status !== "READY" || docx.visibility !== "PUBLIC" || docx.mimeType !== "application/vnd.openxmlformats-officedocument.wordprocessingml.document")) return adminContentResponse({ error: "The optional Word CV must be a verified, public DOCX asset." }, 422);
+  const version = await prisma.$transaction(async (tx) => {
+    if (active) await tx.cvVersion.updateMany({ where: { trackName: track, isActive: true }, data: { isActive: false } });
+    const created = await tx.cvVersion.create({ data: { versionLabel: label, trackName: track, pdfAssetId: pdfId, docxAssetId: docxId, isActive: active } });
+    await tx.portfolioMediaAssetReference.create({ data: { mediaAssetId: pdfId, resourceType: "cv", resourceId: created.id, field: "pdf" } });
+    if (docxId) await tx.portfolioMediaAssetReference.create({ data: { mediaAssetId: docxId, resourceType: "cv", resourceId: created.id, field: "docx" } });
