@@ -0,0 +1,42 @@
+CREATE TYPE "PortfolioMediaAssetVisibility" AS ENUM ('PRIVATE', 'PUBLIC');
+CREATE TYPE "PortfolioMediaAssetStatus" AS ENUM ('UPLOADING', 'READY', 'FAILED');
+
+CREATE TABLE "PortfolioMediaAsset" (
+  "id" UUID NOT NULL,
+  "originalName" VARCHAR(255) NOT NULL,
+  "storageKey" TEXT NOT NULL,
+  "mimeType" VARCHAR(160) NOT NULL,
+  "category" VARCHAR(40) NOT NULL,
+  "sizeBytes" BIGINT NOT NULL,
+  "checksum" CHAR(64),
+  "width" INTEGER,
+  "height" INTEGER,
+  "altText" VARCHAR(300),
+  "tags" JSONB NOT NULL DEFAULT '[]',
+  "variants" JSONB,
+  "visibility" "PortfolioMediaAssetVisibility" NOT NULL DEFAULT 'PRIVATE',
+  "status" "PortfolioMediaAssetStatus" NOT NULL DEFAULT 'UPLOADING',
+  "uploadedById" UUID,
+  "createdAt" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  "updatedAt" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  CONSTRAINT "PortfolioMediaAsset_pkey" PRIMARY KEY ("id"),
+  CONSTRAINT "PortfolioMediaAsset_storageKey_key" UNIQUE ("storageKey"),
+  CONSTRAINT "PortfolioMediaAsset_uploadedById_fkey" FOREIGN KEY ("uploadedById") REFERENCES "AdminUser"("id") ON DELETE SET NULL ON UPDATE CASCADE
+);
+CREATE INDEX "PortfolioMediaAsset_category_createdAt_idx" ON "PortfolioMediaAsset"("category", "createdAt");
+CREATE INDEX "PortfolioMediaAsset_visibility_status_createdAt_idx" ON "PortfolioMediaAsset"("visibility", "status", "createdAt");
+CREATE INDEX "PortfolioMediaAsset_uploadedById_createdAt_idx" ON "PortfolioMediaAsset"("uploadedById", "createdAt");
+
+CREATE TABLE "PortfolioPortfolioMediaAssetReference" (
+  "id" UUID NOT NULL,
+  "mediaAssetId" UUID NOT NULL,
+  "resourceType" VARCHAR(40) NOT NULL,
+  "resourceId" VARCHAR(180) NOT NULL,
+  "field" VARCHAR(80) NOT NULL,
+  "displayLabel" VARCHAR(200),
+  "createdAt" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  CONSTRAINT "PortfolioPortfolioMediaAssetReference_pkey" PRIMARY KEY ("id"),
+  CONSTRAINT "PortfolioPortfolioMediaAssetReference_mediaAssetId_fkey" FOREIGN KEY ("mediaAssetId") REFERENCES "PortfolioMediaAsset"("id") ON DELETE RESTRICT ON UPDATE CASCADE
+);
+CREATE UNIQUE INDEX "PortfolioPortfolioMediaAssetReference_mediaAssetId_resourceType_resourceId_field_key" ON "PortfolioPortfolioMediaAssetReference"("mediaAssetId", "resourceType", "resourceId", "field");
+CREATE INDEX "PortfolioPortfolioMediaAssetReference_resourceType_resourceId_idx" ON "PortfolioPortfolioMediaAssetReference"("resourceType", "resourceId");
