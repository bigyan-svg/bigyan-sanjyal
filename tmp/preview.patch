+  const descriptor = body as UploadDescriptor;
+  const policy = getUploadPolicy(descriptor);
+  if (!policy) return adminContentResponse({ error: "File type or size is not permitted. Images: 10 MB; videos: 150 MB; documents: 50 MB." }, 422);
+  const config = getMediaStorageConfig();
+  const id = randomUUID();
+  const originalName = safeOriginalName(descriptor.name);
+  const key = `portfolio/${new Date().toISOString().slice(0, 7).replace("-", "/")}/${id}/${originalName.replace(/[^a-zA-Z0-9._-]/g, "_")}`;
+  try {
+    await prisma.portfolioMediaAsset.create({ data: { id, originalName, storageKey: key, mimeType: policy.mimeType, category: policy.category, sizeBytes: BigInt(descriptor.size), tags: [], status: "UPLOADING", visibility: "PRIVATE" } });
+    const uploadUrl = await getSignedUrl(getMediaS3Client(), new PutObjectCommand({ Bucket: config.bucket, Key: key, ContentType: policy.mimeType, ContentLength: descriptor.size }), { expiresIn: 300 });
+    return adminContentResponse({ assetId: id, uploadUrl, headers: { "Content-Type": policy.mimeType }, expiresIn: 300 }, 201);
+  } catch {
+    await prisma.portfolioMediaAsset.deleteMany({ where: { id } }).catch(() => undefined);
+    return adminContentResponse({ error: "The upload service is temporarily unavailable. Check preview storage configuration." }, 503);
+  }
+}
