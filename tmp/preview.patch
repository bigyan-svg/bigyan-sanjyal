new file mode 100644
index 0000000..d43e881
--- /dev/null
+++ b/prisma/migrations/20261126141000_blog_seo_metadata/migration.sql
@@ -0,0 +1,5 @@
+ALTER TABLE "Post" ADD COLUMN "seoTitle" VARCHAR(200);
+ALTER TABLE "Post" ADD COLUMN "seoDescription" VARCHAR(300);
+UPDATE "Post"
+SET "readingTimeMins" = GREATEST(1, CEIL(cardinality(regexp_split_to_array(trim("body"), '\s+')) / 200.0)::INTEGER)
+WHERE "readingTimeMins" = 1 AND trim("body") <> '';
