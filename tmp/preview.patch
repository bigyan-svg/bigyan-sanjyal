diff --git a/src/components/admin/inline-media-upload.tsx b/src/components/admin/inline-media-upload.tsx
new file mode 100644
index 0000000..9a56058
--- /dev/null
+++ b/src/components/admin/inline-media-upload.tsx
@@ -0,0 +1,50 @@
+"use client";
+import { useState, type ChangeEvent } from "react";
+import { ImagePlus, LoaderCircle } from "lucide-react";
+interface Props { label: string; accept?: string; disabled?: boolean; resourceType?: string; resourceId?: string; field?: string; onUploaded: (url: string, assetId: string) => void }
+async function postJson(url: string, body: unknown) {
+  const response = await fetch(url, { method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
+  const data = await response.json().catch(() => null);
+  if (!response.ok) throw new Error(typeof data?.error === "string" ? data.error : "Upload request failed.");
+  return data;
+}
+function putFile(url: string, file: File, headers: Record<string, string>, progress: (n: number) => void) {
+  return new Promise<void>((resolve, reject) => {
+    const xhr = new XMLHttpRequest(); xhr.open("PUT", url);
+    Object.entries(headers).forEach(([key, value]) => xhr.setRequestHeader(key, value));
+    xhr.upload.onprogress = (event) => { if (event.lengthComputable) progress(Math.round(event.loaded / event.total * 100)); };
+    xhr.onerror = () => reject(new Error("Upload connection failed."));
+    xhr.onload = () => xhr.status >= 200 && xhr.status < 300 ? resolve() : reject(new Error(`Storage upload failed (${xhr.status}).`));
+    xhr.send(file);
+  });
+}
+export function InlineMediaUpload({ label, accept = ".webp,.png,.jpg,.jpeg,.svg", disabled = false, resourceType, resourceId, field, onUploaded }: Props) {
+  const [busy, setBusy] = useState(false); const [progress, setProgress] = useState(0); const [makePublic, setMakePublic] = useState(true); const [message, setMessage] = useState(""); const [error, setError] = useState("");
+  async function upload(event: ChangeEvent<HTMLInputElement>) {
+    const file = event.currentTarget.files?.[0]; event.currentTarget.value = ""; if (!file) return;
+    setBusy(true); setError(""); setMessage(""); setProgress(0);
+    try {
+      const ticket = await postJson("/api/admin/media/upload-url", { name: file.name, type: file.type, size: file.size });
+      await putFile(ticket.uploadUrl, file, ticket.headers, setProgress);
+      const result = await postJson("/api/admin/media/finalize", { assetId: ticket.assetId, altText: file.name.replace(/\.[^.]+$/, "") });
+      if (makePublic) {
+        const response = await fetch(`/api/admin/media/${ticket.assetId}`, { method: "PATCH", credentials: "same-origin", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ visibility: "PUBLIC" }) });
+        const data = await response.json().catch(() => null);
+        if (!response.ok) throw new Error(data?.error ?? "Could not publish this media asset.");
+      }
+      if (resourceType && resourceId && field) await postJson(`/api/admin/media/${ticket.assetId}/references`, { resourceType, resourceId, field, displayLabel: label });
+      onUploaded(result.asset.url as string, ticket.assetId as string);
+      setMessage(makePublic ? "Uploaded and enabled for public portfolio use." : "Uploaded privately. Make it public in Media Library before publishing this content.");
+    } catch (e) { setError(e instanceof Error ? e.message : "Upload failed."); }
+    finally { setBusy(false); }
+  }
+  return <div className="inline-media-upload">
+    <div className="inline-media-upload__row">
+      <label className="inline-media-upload__file"><ImagePlus size={16} aria-hidden="true" />{label}<input type="file" accept={accept} disabled={disabled || busy} onChange={upload} /></label>
+      <label className="inline-media-upload__public"><input type="checkbox" checked={makePublic} onChange={(event) => setMakePublic(event.target.checked)} disabled={busy} /> Public asset</label>
+    </div>
+    {busy ? <p className="inline-media-upload__status" role="status"><LoaderCircle size={14} className="inline-media-upload__spinner" /> Uploading and verifying… {progress}%</p> : null}
+    {message ? <p className="inline-media-upload__status" role="status">{message}</p> : null}
+    {error ? <p className="inline-media-upload__error" role="alert">{error}</p> : null}
+  </div>;
+}
