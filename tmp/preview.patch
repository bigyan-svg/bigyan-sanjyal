@@ -0,0 +1,56 @@
+import "server-only";
+import { createHash } from "node:crypto";
+import { HeadObjectCommand } from "@aws-sdk/client-s3";
+import { Prisma } from "@/generated/prisma/client";
+import { adminContentResponse, authorizeAdminContentWrite } from "@/lib/auth/admin-content";
+import { prisma } from "@/lib/prisma";
+import { verifyMagicBytes, verifyZipPackage } from "@/lib/media/policy";
+import { deleteStoredObject, makeImageVariants, putStoredObject, readStoredObject, sanitizeSvg } from "@/lib/media/processing";
+import { getMediaS3Client, getMediaStorageConfig } from "@/lib/media/storage";
+export async function POST(request: Request) {
+  const denied = await authorizeAdminContentWrite(request);
+  if (denied) return denied;
+  let body: unknown;
+  try { body = await request.json(); } catch { return adminContentResponse({ error: "Invalid finalization request." }, 400); }
+  const id = body && typeof body === "object" && "assetId" in body && typeof body.assetId === "string" ? body.assetId : "";
+  if (!/^[0-9a-f-]{36}$/i.test(id)) return adminContentResponse({ error: "Invalid media identifier." }, 400);
+  const asset = await prisma.portfolioMediaAsset.findUnique({ where: { id } });
+  if (!asset || asset.status !== "UPLOADING") return adminContentResponse({ error: "This upload is no longer pending." }, 404);
+  const config = getMediaStorageConfig();
+  try {
+    const head = await getMediaS3Client().send(new HeadObjectCommand({ Bucket: config.bucket, Key: asset.storageKey }));
+    if (!head.ContentLength || BigInt(head.ContentLength) !== asset.sizeBytes || head.ContentType !== asset.mimeType) throw new Error("Upload size or content type does not match the declared file.");
+    const extension = asset.originalName.split(".").pop()?.toLowerCase() ?? "";
+    const sample = await readStoredObject(asset.storageKey, "bytes=0-4095");
+    if (!verifyMagicBytes(extension, sample)) throw new Error("The uploaded file signature does not match its extension.");
+    let checksum: string | null = null;
+    let width: number | null = null;
+    let height: number | null = null;
+    let variants: Prisma.InputJsonValue | typeof Prisma.DbNull = Prisma.DbNull;
+    if (asset.category === "image") {
+      let bytes = await readStoredObject(asset.storageKey);
+      if (extension === "svg") {
+        bytes = sanitizeSvg(bytes);
+        await putStoredObject(asset.storageKey, bytes, "image/svg+xml");
+        checksum = createHash("sha256").update(bytes).digest("hex");
+      } else {
+        checksum = createHash("sha256").update(bytes).digest("hex");
+        const processed = await makeImageVariants(asset.storageKey, bytes);
+        width = processed.width; height = processed.height; variants = processed.variants as Prisma.InputJsonValue;
+      }
+    } else if (asset.sizeBytes <= BigInt(50 * 1024 * 1024)) {
+      const bytes = await readStoredObject(asset.storageKey);
+      if (["docx", "pptx", "xlsx", "zip"].includes(extension) && !verifyZipPackage(extension, bytes)) throw new Error("The archive structure is invalid or does not match the selected Office format.");
+      checksum = createHash("sha256").update(bytes).digest("hex");
+    }
+    const input = body as Record<string, unknown>;
+    const altText = typeof input.altText === "string" ? input.altText.trim().slice(0, 300) || null : null;
+    const updated = await prisma.portfolioMediaAsset.update({ where: { id }, data: { status: "READY", checksum, width, height, variants, altText } });
+    return adminContentResponse({ asset: { id: updated.id, originalName: updated.originalName, mimeType: updated.mimeType, category: updated.category, sizeBytes: updated.sizeBytes.toString(), width: updated.width, height: updated.height, status: updated.status, visibility: updated.visibility, url: `/api/media/${updated.id}` } }, 200);
+  } catch (error) {
+    await deleteStoredObject(asset.storageKey).catch(() => undefined);
+    await prisma.portfolioMediaAsset.update({ where: { id }, data: { status: "FAILED" } }).catch(() => undefined);
+    const message = error instanceof Error && /signature|size|content type|malformed|dimensions|processing limit/i.test(error.message) ? error.message : "Unable to verify this upload. Please upload a valid file and try again.";
+    return adminContentResponse({ error: message }, 422);
+  }
+}
