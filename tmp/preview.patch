@@ -0,0 +1,17 @@
+"use client";
+import { useState } from "react";
+import { Check, Copy, Share2 } from "lucide-react";
+export function ArticleShare({ title }: { title: string }) {
+  const [copied, setCopied] = useState(false);
+  function openShare(provider: "linkedin" | "x") {
+    const url = encodeURIComponent(window.location.href);
+    const text = encodeURIComponent(title);
+    const target = provider === "linkedin" ? `https://www.linkedin.com/sharing/share-offsite/?url=${url}` : `https://twitter.com/intent/tweet?url=${url}&text=${text}`;
+    window.open(target, "_blank", "noopener,noreferrer");
+  }
+  async function copyLink() {
+    try { await navigator.clipboard.writeText(window.location.href); setCopied(true); window.setTimeout(() => setCopied(false), 1800); }
+    catch { setCopied(false); }
+  }
+  return <div className="public-blog-article__share" aria-label="Share article"><span><Share2 size={15} aria-hidden="true" /> Share</span><button type="button" onClick={() => openShare("linkedin")}>LinkedIn</button><button type="button" onClick={() => openShare("x")}>X</button><button type="button" onClick={copyLink}>{copied ? <Check size={14} /> : <Copy size={14} />}{copied ? "Copied" : "Copy link"}</button></div>;
+}
diff --git a/src/components/blog/markdown-renderer.tsx b/src/components/blog/markdown-renderer.tsx
new file mode 100644
index 0000000..bb948f2
--- /dev/null
+++ b/src/components/blog/markdown-renderer.tsx
@@ -0,0 +1,46 @@
+"use client";
+import { useMemo, useRef, useState } from "react";
+import ReactMarkdown, { type Components } from "react-markdown";
+import remarkGfm from "remark-gfm";
+import remarkMath from "remark-math";
+import rehypeKatex from "rehype-katex";
+import rehypeHighlight from "rehype-highlight";
+import rehypeSlug from "rehype-slug";
+import GithubSlugger from "github-slugger";
+import { Check, Copy } from "lucide-react";
+interface Props { body: string; compact?: boolean; showTableOfContents?: boolean }
+function CodeBlock({ children, className }: { children?: React.ReactNode; className?: string }) {
+  const ref = useRef<HTMLElement | null>(null); const [copied, setCopied] = useState(false);
+  async function copy() {
+    try { await navigator.clipboard.writeText(ref.current?.textContent ?? ""); setCopied(true); window.setTimeout(() => setCopied(false), 1500); }
+    catch { setCopied(false); }
+  }
+  return <div className="markdown-code-block"><button type="button" className="markdown-code-block__copy" onClick={copy} aria-label="Copy code"><>{copied ? <Check size={14} /> : <Copy size={14} />}{copied ? "Copied" : "Copy"}</></button><pre><code ref={ref} className={className}>{children}</code></pre></div>;
+}
+const components: Components = {
+  code({ children, className }) {
+    return className ? <CodeBlock className={className}>{children}</CodeBlock> : <code className={className}>{children}</code>;
+  },
+  a({ href, children, node, ...props }) {
+    void node;
+    const external = typeof href === "string" && /^https?:\/\//iu.test(href);
+    const linkProps = Object.fromEntries(Object.entries(props).filter(([key]) => key !== "node"));
+    return <a href={href} {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})} {...linkProps}>{children}</a>;
+  },
+};
+function extractHeadings(body: string) {
+  const slugger = new GithubSlugger();
+  return body.split(/\r?\n/u).flatMap((line) => {
+    const match = /^(#{1,3})\s+(.+?)\s*#*$/u.exec(line.trim());
+    if (!match) return [];
+    const title = match[2].replace(/[`*_~]/gu, "").trim();
+    return [{ id: slugger.slug(title), title, level: match[1].length }];
+  });
+}
+export function MarkdownRenderer({ body, compact = false, showTableOfContents = false }: Props) {
+  const headings = useMemo(() => extractHeadings(body), [body]);
+  return <div className={`markdown-document${compact ? " markdown-document--compact" : ""}`}>
+    {showTableOfContents && headings.length > 1 ? <nav className="markdown-document__toc" aria-label="Table of contents"><strong>On this page</strong><ol>{headings.map((heading, index) => <li key={`${heading.id}-${index}`} data-level={heading.level}><a href={`#${heading.id}`}>{heading.title}</a></li>)}</ol></nav> : null}
+    <div className="markdown-document__content"><ReactMarkdown remarkPlugins={[remarkGfm, remarkMath]} rehypePlugins={[rehypeSlug, rehypeHighlight, rehypeKatex]} components={components}>{body}</ReactMarkdown></div>
+  </div>;
+}
